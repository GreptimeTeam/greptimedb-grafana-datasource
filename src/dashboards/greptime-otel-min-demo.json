          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "${DS_GREPTIMEDB}"
          },
          "editorType": "builder",
          "format": 1,
          "pluginVersion": "2.2.1",
          "queryType": "table",
          "builderOptions": {
            "database": "public",
            "table": "opentelemetry_traces",
            "queryType": "table",
            "mode": "aggregate",
            "columns": [
              {
                "name": "timestamp",
                "hint": "time"
              }
            ],
            "aggregates": [
              {
                "aggregateType": "count",
                "column": "timestamp",
                "alias": "error_count"
              }
            ],
            "filters": [
              {
                "filterType": "custom",
                "key": "",
                "hint": "time",
                "operator": "WITH IN DASHBOARD TIME RANGE",
                "type": "datetime",
                "condition": "AND"
              },
              {
                "filterType": "custom",
                "key": "span_status_code",
                "type": "string",
                "operator": "=",
                "value": "STATUS_CODE_ERROR",
                "condition": "AND"
              }
            ],
            "orderBy": [],
            "limit": 0,
            "meta": {}
          },
          "rawSql": "SELECT COUNT(\"timestamp\") AS \"error_count\" FROM \"public\".\"opentelemetry_traces\" WHERE $__timeFilter(\"timestamp\") AND (\"span_status_code\" = 'STATUS_CODE_ERROR')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
