    {
      "type": "timeseries",
      "title": "Time Series + Multi-Frame\uff1aRequest Rate by Model",
      "description": "Query Builder \u2192 Timeseries (Trend). date_bin + COUNT grouped by gen_ai.request.model (multi-frame).",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "${DS_GREPTIMEDB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "${DS_GREPTIMEDB}"
          },
          "editorType": "builder",
          "format": 0,
          "pluginVersion": "2.2.1",
          "queryType": "timeseries",
          "builderOptions": {
            "database": "public",
            "table": "opentelemetry_traces",
            "queryType": "timeseries",
            "mode": "trend",
            "columns": [
              {
                "name": "timestamp",
                "hint": "time"
              },
              {
                "name": "span_attributes.gen_ai.request.model"
              }
            ],
            "aggregates": [
              {
                "aggregateType": "count",
                "column": "timestamp",
                "alias": "request_count"
              }
            ],
            "groupBy": [
              "span_attributes.gen_ai.request.model"
            ],
            "filters": [
              {
                "filterType": "custom",
                "key": "",
                "hint": "time",
                "operator": "WITH IN DASHBOARD TIME RANGE",
                "type": "datetime",
                "condition": "AND"
              },
              {
                "filterType": "custom",
                "key": "span_attributes.gen_ai.system",
                "type": "string",
                "operator": "IS NOT NULL",
                "condition": "AND"
              }
            ],
            "orderBy": [
              {
                "name": "timestamp",
                "hint": "time",
                "dir": "asc"
              }
            ],
            "limit": 0,
            "meta": {}
          },
          "rawSql": "SELECT date_bin('$__interval', \"timestamp\") AS time, `span_attributes.gen_ai.request.model`, COUNT(\"timestamp\") AS \"request_count\" FROM \"public\".\"opentelemetry_traces\" WHERE $__timeFilter(\"timestamp\") AND (`span_attributes.gen_ai.system` IS NOT NULL) GROUP BY time, `span_attributes.gen_ai.request.model` ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
