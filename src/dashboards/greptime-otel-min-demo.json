    {
      "type": "table",
      "title": "Trace Search + Data Link\uff1aRecent Spans",
      "description": "Query Builder \u2192 Traces (Trace Search). Click trace_id \u2192 View trace / View logs (needs Logs Config Default Table).",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "${DS_GREPTIMEDB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "${DS_GREPTIMEDB}"
          },
          "editorType": "builder",
          "format": 1,
          "pluginVersion": "2.2.1",
          "queryType": "traces",
          "builderOptions": {
            "database": "public",
            "table": "opentelemetry_traces",
            "queryType": "traces",
            "columns": [
              {
                "name": "trace_id",
                "hint": "trace_id"
              },
              {
                "name": "span_name",
                "hint": "trace_operation_name"
              },
              {
                "name": "service_name",
                "hint": "trace_service_name"
              },
              {
                "name": "timestamp",
                "hint": "time"
              },
              {
                "name": "duration_nano",
                "hint": "trace_duration_time"
              },
              {
                "name": "span_status_code",
                "hint": "trace_status_code"
              }
            ],
            "filters": [
              {
                "filterType": "custom",
                "key": "",
                "hint": "time",
                "operator": "WITH IN DASHBOARD TIME RANGE",
                "type": "datetime",
                "condition": "AND"
              }
            ],
            "orderBy": [
              {
                "name": "timestamp",
                "hint": "time",
                "dir": "desc"
              }
            ],
            "limit": 50,
            "meta": {
              "otelEnabled": true,
              "otelVersion": "latest",
              "isTraceIdMode": false
            }
          },
          "rawSql": "SELECT trace_id, span_name, service_name, CAST(\"timestamp\" AS INT64) / 1000000 AS timestamp_ms, FLOOR(duration_nano * 0.000001) AS duration_ms, span_status_code AS status FROM opentelemetry_traces WHERE $__timeFilter(\"timestamp\") ORDER BY \"timestamp\" DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "STATUS_CODE_ERROR": {
                        "color": "red",
                        "text": "ERROR"
                      },
                      "STATUS_CODE_UNSET": {
                        "color": "green",
                        "text": "OK"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "timestamp_ms",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "traces",
      "title": "Trace ID Mode + Waterfall\uff1aTrace Detail",
      "description": "Query Builder \u2192 Traces (Trace ID mode). Paste Trace ID from Search or the dashboard variable. View logs needs Logs Config Default Table.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "${DS_GREPTIMEDB}"
      },
      "targets": [
        {
          "refId": "Trace ID",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "${DS_GREPTIMEDB}"
          },
          "editorType": "builder",
          "format": 3,
          "pluginVersion": "2.2.1",
          "queryType": "traces",
          "builderOptions": {
            "database": "public",
            "table": "opentelemetry_traces",
            "queryType": "traces",
            "columns": [
              {
                "name": "trace_id",
                "hint": "trace_id"
              },
              {
                "name": "span_id",
                "hint": "trace_span_id"
              },
              {
                "name": "parent_span_id",
                "hint": "trace_parent_span_id"
              },
              {
                "name": "service_name",
                "hint": "trace_service_name"
              },
              {
                "name": "span_name",
                "hint": "trace_operation_name"
              },
              {
                "name": "timestamp",
                "hint": "time"
              },
              {
                "name": "duration_nano",
                "hint": "trace_duration_time"
              },
              {
                "name": "span_status_code",
                "hint": "trace_status_code"
              },
              {
                "name": "span_attributes.gen_ai.system",
                "hint": "trace_tags"
              },
              {
                "name": "span_attributes.gen_ai.request.model",
                "hint": "trace_tags"
              },
              {
                "name": "resource_attributes.telemetry.sdk.name",
                "hint": "trace_service_tags"
              }
            ],
            "filters": [
              {
                "filterType": "custom",
                "key": "",
                "hint": "time",
                "operator": "WITH IN DASHBOARD TIME RANGE",
                "type": "datetime",
                "condition": "AND"
              }
            ],
            "orderBy": [],
            "limit": 1000,
            "meta": {
              "traceDurationUnit": "nanoseconds",
              "isTraceIdMode": true,
              "otelEnabled": true,
              "otelVersion": "latest"
            }
          },
          "rawSql": "SELECT * FROM opentelemetry_traces WHERE timestamp >= $__fromTime AND timestamp <= $__toTime AND trace_id = COALESCE(NULLIF('${trace_id}', ''), (SELECT trace_id FROM opentelemetry_traces WHERE timestamp >= $__fromTime AND timestamp <= $__toTime ORDER BY \"timestamp\" DESC LIMIT 1)) ORDER BY \"timestamp\""
        }
      ]
    }
  ],
