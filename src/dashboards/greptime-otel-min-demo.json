    {
      "type": "logs",
      "title": "Logs Query + View Trace\uff1aConversations",
      "description": "Query Builder \u2192 Logs. Expand a line or use trace_id for plugin View Trace (needs Logs Config Default Table / Trace ID Column).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "${DS_GREPTIMEDB}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "${DS_GREPTIMEDB}"
          },
          "editorType": "builder",
          "format": 2,
          "pluginVersion": "2.2.1",
          "queryType": "logs",
          "builderOptions": {
            "database": "public",
            "table": "genai_conversations",
            "queryType": "logs",
            "mode": "list",
            "columns": [
              {
                "name": "timestamp",
                "hint": "time"
              },
              {
                "name": "severity_text",
                "hint": "log_level"
              },
              {
                "name": "body",
                "hint": "log_message"
              },
              {
                "name": "trace_id",
                "hint": "trace_id"
              },
              {
                "name": "scope_name"
              }
            ],
            "filters": [
              {
                "filterType": "custom",
                "key": "",
                "hint": "time",
                "operator": "WITH IN DASHBOARD TIME RANGE",
                "type": "datetime",
                "condition": "AND"
              }
            ],
            "orderBy": [
              {
                "name": "timestamp",
                "hint": "time",
                "dir": "desc"
              }
            ],
            "limit": 100,
            "meta": {
              "otelEnabled": true,
              "otelVersion": "latest"
            }
          },
          "rawSql": "SELECT \"timestamp\" AS timestamp, body AS body, severity_text AS level, scope_name, trace_id FROM genai_conversations WHERE $__timeFilter(\"timestamp\") AND ('${search}' = '' OR matches_term(body, '${search}')) AND ('${trace_id}' = '' OR trace_id = '${trace_id}') AND body IS NOT NULL ORDER BY \"timestamp\" DESC LIMIT 100"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
